# Base image configuration
UBUNTU_VERSION=22.04

# Prebuilt classroom image
DEVCONTAINER_IMAGE=iamhxx/isdn3000e-ros2-humble-lab10:latest

# Workspace configuration
WORKSPACE_DIR=/workspace

# User configuration - prefixed `DEVCONTAINER_` to avoid conflicts with host USERNAME/UID/GID
DEVCONTAINER_USERNAME=developer
DEVCONTAINER_UID=1000
DEVCONTAINER_GID=1000
